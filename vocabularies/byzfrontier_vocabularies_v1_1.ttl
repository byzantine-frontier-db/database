#####################################################################
# 3. DATING SYSTEMS
#####################################################################

:dating-systems a skos:ConceptScheme ; dct:title "Dating Systems"@en .

:ds-ad a skos:Concept ; skos:inScheme :dating-systems ;
    skos:prefLabel "Anno Domini"@en ; skos:notation "AD" ;
    bzfdb:aat_match_status "pending" ; bzfdb:aat_search_term "Christian era" .
:ds-bc a skos:Concept ; skos:inScheme :dating-systems ; skos:prefLabel "Before Christ"@en ; skos:notation "BC" .
:ds-ce a skos:Concept ; skos:inScheme :dating-systems ; skos:prefLabel "Common Era"@en ; skos:notation "CE" ; skos:exactMatch :ds-ad .
:ds-bce a skos:Concept ; skos:inScheme :dating-systems ; skos:prefLabel "Before Common Era"@en ; skos:notation "BCE" ; skos:exactMatch :ds-bc .
:ds-ah a skos:Concept ; skos:inScheme :dating-systems ;
    skos:prefLabel "Anno Hegirae"@en ; skos:notation "AH" ;
    skos:definition "Islamic lunar calendar from 16 July 622 CE."@en ;
    bzfdb:aat_match_status "pending" ; bzfdb:aat_search_term "Islamic calendar / Hijri" .
:ds-am-byzantine a skos:Concept ; skos:inScheme :dating-systems ;
    skos:prefLabel "Anno Mundi (Byzantine)"@en ; skos:notation "AM_byzantine" ;
    bzfdb:aat_match_status "pending" ; bzfdb:aat_search_term "Byzantine calendar / Anno Mundi" .
:ds-am-alexandrian a skos:Concept ; skos:inScheme :dating-systems ; skos:prefLabel "Anno Mundi (Alexandrian)"@en ; skos:notation "AM_alexandrian" .
:ds-regnal-byzantine a skos:Concept ; skos:inScheme :dating-systems ; skos:prefLabel "Byzantine regnal year"@en ; skos:notation "regnal_byzantine" .
:ds-regnal-abbasid a skos:Concept ; skos:inScheme :dating-systems ; skos:prefLabel "Abbasid regnal year"@en ; skos:notation "regnal_abbasid" .
:ds-regnal-umayyad a skos:Concept ; skos:inScheme :dating-systems ; skos:prefLabel "Umayyad regnal year"@en ; skos:notation "regnal_umayyad" .
:ds-indiction a skos:Concept ; skos:inScheme :dating-systems ;
    skos:prefLabel "Indiction"@en ; skos:notation "indiction" ;
    bzfdb:aat_match_status "pending" ; bzfdb:aat_search_term "indiction" .
:ds-seleucid a skos:Concept ; skos:inScheme :dating-systems ; skos:prefLabel "Seleucid era"@en ; skos:notation "seleucid" .
:ds-olympiad a skos:Concept ; skos:inScheme :dating-systems ; skos:prefLabel "Olympiad"@en ; skos:notation "olympiad" .
:ds-archaeological a skos:Concept ; skos:inScheme :dating-systems ; skos:prefLabel "Archaeological phase"@en ; skos:notation "archaeological_phase" .
:ds-palaeographic a skos:Concept ; skos:inScheme :dating-systems ; skos:prefLabel "Palaeographic"@en ; skos:notation "palaeographic" .
:ds-radiocarbon a skos:Concept ; skos:inScheme :dating-systems ; skos:prefLabel "Radiocarbon"@en ; skos:notation "radiocarbon" .


