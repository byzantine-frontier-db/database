@prefix :       <https://byzantine-frontier-db.org/vocab/> .
@prefix bzfdb:  <https://byzantine-frontier-db.org/vocab/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix aat:    <http://vocab.getty.edu/aat/> .
@prefix periodo: <http://n2t.net/ark:/99152/> .

#####################################################################
# Byzantine-Islamic Frontier Database — Controlled Vocabularies (SKOS)
# Version 1.1.0
# Changes from v1.0.0:
#   - Verified AAT closeMatch links added for confirmed terms
#   - bzfdb:aat_match_status property added for editorial tracking
#   - PeriodO references where applicable
#   - Annotation property bzfdb:aat_search_term gives editors a starting
#     point for verifying remaining AAT links
#   - Three 'other' catch-all concepts added (coordinate methods, place
#     types, source genres) — fixes coverage gap from v1.0
#
# AAT verification methodology:
#   1. Search at http://www.getty.edu/research/tools/vocabularies/aat/
#   2. Identify the term whose scope_note matches the byzfrontier concept
#   3. Copy the 9-digit AAT ID and the canonical URI
#   4. Add as skos:closeMatch (or skos:exactMatch if synonymous)
#   5. Change bzfdb:aat_match_status from 'pending' to 'verified'
#   6. Submit via PR; merge after Editorial Board review (governance §4.5)
#####################################################################


# Property used to track AAT verification status. Values: 'verified',
# 'pending', or 'no_equivalent'.
bzfdb:aat_match_status a rdf:Property ;
    rdfs:comment "Status of AAT alignment for this concept. 'verified': skos:closeMatch present and reviewed. 'pending': skos:closeMatch not yet added; editor should search AAT. 'no_equivalent': searched, no acceptable AAT match exists."@en .

bzfdb:aat_search_term a rdf:Property ;
    rdfs:comment "Suggested AAT search term to help editors find a closeMatch. Free-text hint, not a binding mapping."@en .

bzfdb:periodo_ref a rdf:Property ;
    rdfs:comment "PeriodO period URI for time-bounded concepts."@en .


#####################################################################
# 1. CONFIDENCE LEVELS
#####################################################################

:confidence-levels a skos:ConceptScheme ;
    dct:title "Confidence Levels"@en ;
    dct:description "Five-level confidence scale used throughout the database."@en .

:confidence-5 a skos:Concept ; skos:inScheme :confidence-levels ; skos:topConceptOf :confidence-levels ;
    skos:prefLabel "Certain"@en ; skos:notation "5" ;
    skos:definition "Directly attested and uncontested."@en ;
    bzfdb:aat_match_status "no_equivalent" .

:confidence-4 a skos:Concept ; skos:inScheme :confidence-levels ; skos:topConceptOf :confidence-levels ;
    skos:prefLabel "Highly Probable"@en ; skos:notation "4" ;
    skos:definition "Strongly supported by multiple independent lines of evidence."@en ;
    bzfdb:aat_match_status "no_equivalent" .

:confidence-3 a skos:Concept ; skos:inScheme :confidence-levels ; skos:topConceptOf :confidence-levels ;
    skos:prefLabel "Probable"@en ; skos:notation "3" ;
    skos:definition "Supported by evidence but not beyond reasonable dispute."@en ;
    bzfdb:aat_match_status "no_equivalent" .

:confidence-2 a skos:Concept ; skos:inScheme :confidence-levels ; skos:topConceptOf :confidence-levels ;
    skos:prefLabel "Possible"@en ; skos:notation "2" ;
    skos:definition "Plausible but weakly supported."@en ;
    bzfdb:aat_match_status "no_equivalent" .

:confidence-1 a skos:Concept ; skos:inScheme :confidence-levels ; skos:topConceptOf :confidence-levels ;
    skos:prefLabel "Speculative"@en ; skos:notation "1" ;
    skos:definition "Hypothetical or highly uncertain."@en ;
    bzfdb:aat_match_status "no_equivalent" .


