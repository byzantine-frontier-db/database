:environmental a skos:Concept ; skos:inScheme :event-types ; skos:topConceptOf :event-types ; skos:prefLabel "Environmental"@en .
:construction-infrastructure a skos:Concept ; skos:inScheme :event-types ; skos:topConceptOf :event-types ; skos:prefLabel "Construction & infrastructure"@en .

