#####################################################################
# 7. EVENT TYPES — top-level categories + sub-categories
#####################################################################

:event-types a skos:ConceptScheme ; dct:title "Event Types"@en .

# Top-level: military
:military a skos:Concept ; skos:inScheme :event-types ; skos:topConceptOf :event-types ;
    skos:prefLabel "Military"@en ;
    skos:closeMatch aat:300055314 ;
    bzfdb:aat_match_status "verified" ;
    rdfs:comment "AAT 300055314 = 'wars'. Verified via Getty AAT subject query (see https://vocab.getty.edu/aat/300055314)."@en .

:political a skos:Concept ; skos:inScheme :event-types ; skos:topConceptOf :event-types ; skos:prefLabel "Political"@en .
